APP_NAME="Memory Vault"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://example.com
APP_TIMEZONE=UTC
TRUSTED_PROXIES=

LOG_CHANNEL=daily
LOG_LEVEL=info
LOG_DAYS=14

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=memoryvault
DB_USERNAME=
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=129600
SESSION_EXPIRE_ON_CLOSE=false
SESSION_ENCRYPT=true
SESSION_COOKIE=memoryvault_session
SESSION_PATH=/
SESSION_DOMAIN=
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax

CACHE_STORE=file
QUEUE_CONNECTION=sync

MAIL_MAILER=smtp
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_TIMEOUT=10
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME="Memory Vault"

# Google Drive Storage
# Base64-encoded service account JSON, OR path to the JSON file.
GOOGLE_SERVICE_ACCOUNT_KEY=
GOOGLE_SERVICE_ACCOUNT_KEY_FILE=

# Storage mode — one of two:
#
# Mode 1: Google Shared Drive (Google Workspace)
#   Set GOOGLE_SHARED_DRIVE_ID to the Shared Drive ID.
#   Event folders are created at the Shared Drive root.
#
# Mode 2: Personal Google Drive (standard Google account)
#   Leave GOOGLE_SHARED_DRIVE_ID empty.
#   Set GOOGLE_STORAGE_ROOT_FOLDER_ID to an existing folder ID in My Drive.
#   Event folders are created inside that folder.
#
# The application automatically selects the mode based on whether
# GOOGLE_SHARED_DRIVE_ID is set. No other configuration is needed.
GOOGLE_SHARED_DRIVE_ID=
GOOGLE_STORAGE_ROOT_FOLDER_ID=

MEMORYVAULT_CLIENT_KEY=
MEMORYVAULT_UPLOAD_NONCE_TTL_HOURS=24
MEMORYVAULT_MAX_SUBMISSION_BYTES=2147483648
MEMORYVAULT_UPLOAD_MAX_CONCURRENT=3
MEMORYVAULT_UPLOAD_MAX_RETRIES=3
MEMORYVAULT_UPLOAD_CHUNK_SIZE=8388608
MEMORYVAULT_UPLOAD_REQUEST_TIMEOUT_MS=120000
MEMORYVAULT_DRIVE_QUOTA_WARNING_PERCENT=80
MEMORYVAULT_UPLOAD_STRATEGY=plan_b

ADMIN_EMAIL=
ADMIN_PASSWORD=
